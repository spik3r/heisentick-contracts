{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-run-result.v1.schema.json",
  "title": "Validation run result envelope",
  "description": "Written by the Assemble step to runs/<runId>/<attempt>/envelope.json and summarised in the result queue message. Small by design: headline statistics and references. Trade lists and grid cells stay in their own objects. Three statuses are separate on purpose: execution (did it run), assessment (could statistics be judged), promotion (does it clear the policy). Insufficient data is never a failure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "runId", "attempt", "inputFingerprint", "manifestKey", "execution", "assessment", "promotion", "headline", "artifacts", "engine", "finishedAt"],
  "properties": {
    "schema": { "const": "heisentick/validation-run-result" },
    "version": { "const": 1 },
    "runId": { "$ref": "common.v1.schema.json#/$defs/uuid" },
    "attempt": { "type": "integer", "minimum": 1 },
    "inputFingerprint": { "$ref": "common.v1.schema.json#/$defs/sha256Hex" },
    "manifestKey": { "$ref": "common.v1.schema.json#/$defs/s3Key" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stages"],
      "properties": {
        "status": { "type": "string", "enum": ["succeeded", "failed", "cancelled", "timeout"] },
        "failedStage": { "type": "string", "enum": ["report", "grid", "montecarlo", "diagnostics", "assemble"] },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
            "message": { "type": "string", "maxLength": 2000 }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "status", "durationMs"],
            "properties": {
              "stage": { "type": "string", "enum": ["report", "grid", "montecarlo", "diagnostics", "assemble"] },
              "status": { "type": "string", "enum": ["succeeded", "failed", "skipped", "timeout"] },
              "durationMs": { "type": "integer", "minimum": 0 },
              "billedMs": { "type": "integer", "minimum": 0 },
              "maxMemoryMb": { "type": "integer", "minimum": 0 },
              "cells": { "type": "integer", "minimum": 0, "description": "Grid only: cells completed." }
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["assessed", "insufficient-data", "not-applicable", "unassessed"] },
        "reason": { "$ref": "common.v1.schema.json#/$defs/metricReason" },
        "minimumTrades": { "type": "integer", "minimum": 0 }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "policyVersion"],
      "properties": {
        "status": { "type": "string", "enum": ["eligible", "not-eligible", "unassessed"] },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "passed", "value", "threshold", "comparator"],
            "properties": {
              "name": { "type": "string", "maxLength": 64 },
              "passed": { "type": "boolean" },
              "value": { "$ref": "common.v1.schema.json#/$defs/nullableMetric" },
              "threshold": { "type": "number" },
              "comparator": { "type": "string", "enum": ["at-least", "above", "at-most", "below"], "description": "value >= threshold, > , <= , < respectively." }
            }
          }
        }
      }
    },
    "headline": {
      "description": "null when execution did not succeed.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["trades", "winRate", "profitFactor", "net", "expectancy", "maxDrawdown", "firstTradeT", "lastTradeT"],
          "properties": {
            "trades": { "type": "integer", "minimum": 0 },
            "winRate": { "$ref": "common.v1.schema.json#/$defs/nullableMetric" },
            "profitFactor": { "$ref": "common.v1.schema.json#/$defs/nullableMetric" },
            "profitFactorReason": { "$ref": "common.v1.schema.json#/$defs/metricReason" },
            "net": { "type": "number" },
            "expectancy": { "$ref": "common.v1.schema.json#/$defs/nullableMetric" },
            "maxDrawdown": { "type": "number", "minimum": 0 },
            "maxDrawdownUnit": { "type": "string", "enum": ["percent-of-peak-equity", "currency"], "description": "Unit of maxDrawdown. The Go report emits percent-of-peak-equity; absent means unspecified (pre-0.2.1 producers)." },
            "firstTradeT": { "anyOf": [{ "$ref": "common.v1.schema.json#/$defs/epochMs" }, { "type": "null" }] },
            "lastTradeT": { "anyOf": [{ "$ref": "common.v1.schema.json#/$defs/epochMs" }, { "type": "null" }] },
            "monteCarlo": {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "iterations", "drawdownP5", "drawdownP50", "drawdownP95"],
              "properties": {
                "method": { "type": "string", "enum": ["permutation", "bootstrap"] },
                "iterations": { "type": "integer", "minimum": 1 },
                "drawdownP5": { "type": "number", "minimum": 0 },
                "drawdownP50": { "type": "number", "minimum": 0 },
                "drawdownP95": { "type": "number", "minimum": 0 }
              }
            },
            "holdout": {
              "description": "Present only when the manifest carried holdoutFromT.",
              "type": "object",
              "additionalProperties": false,
              "required": ["trades", "profitFactor", "net"],
              "properties": {
                "trades": { "type": "integer", "minimum": 0 },
                "profitFactor": { "$ref": "common.v1.schema.json#/$defs/nullableMetric" },
                "net": { "type": "number" }
              }
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Object references. A succeeded run carries report (and a non-null headline); a run that failed before or during Report has none. The schema states the shapes; the rule 'succeeded implies report and headline' is enforced by both packages in code because a root-level conditional would defeat the generated zod object's rejection of unknown fields.",
      "properties": {
        "report": { "$ref": "#/$defs/artifactRef" },
        "trades": { "$ref": "#/$defs/artifactRef" },
        "grid": { "$ref": "#/$defs/artifactRef" },
        "monteCarlo": { "$ref": "#/$defs/artifactRef" },
        "diagnostics": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stratRelease", "stratBuildDigest", "validationRelease"],
      "properties": {
        "stratRelease": { "$ref": "common.v1.schema.json#/$defs/semverTag" },
        "stratBuildDigest": { "$ref": "common.v1.schema.json#/$defs/sha256Hex", "description": "sha256 reported by the result publisher for its executor binary. The current Lambda producer reports the Assemble executable; local execution reports the standalone strat executable. It does not prove the identity of a statically linked Report engine and need not equal the manifest's release-artifact digest." },
        "validationRelease": { "$ref": "common.v1.schema.json#/$defs/semverTag" }
      }
    },
    "finishedAt": { "$ref": "common.v1.schema.json#/$defs/epochMs" }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object", "sha256", "byteLength", "schema", "version"],
      "properties": {
        "object": { "$ref": "common.v1.schema.json#/$defs/s3Key" },
        "sha256": { "$ref": "common.v1.schema.json#/$defs/sha256Hex" },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 52428800 },
        "schema": { "type": "string", "pattern": "^heisentick/[a-z][a-z0-9-]*$" },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
