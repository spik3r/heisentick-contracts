{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cot-job-manifest.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "jobId",
    "datasetId",
    "contractCodes",
    "requested",
    "from",
    "to",
    "count",
    "complete",
    "error",
    "files",
    "payload",
    "producedAt"
  ],
  "properties": {
    "schema": {
      "const": "heisentick/cot-job-manifest"
    },
    "version": {
      "const": 2
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "datasetId": {
      "enum": [
        "gpe5-46if",
        "72hh-3qpy"
      ]
    },
    "contractCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9+]{1,12}$"
      }
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "from": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "to": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "complete": {
      "type": "boolean"
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^COT_[A-Z_]+$"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "byteLength",
            "sha256"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "producedAt": {
      "type": "string"
    }
  }
}
