{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-run-request.v1.schema.json",
  "title": "Validation run request",
  "description": "Body of POST /api/v1/strategy-validation/runs. The API resolves it into a validation-run-manifest; nothing here is read by a worker. Unknown fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "requestKey", "kind", "strategyId", "route", "costMode"],
  "properties": {
    "schema": { "const": "heisentick/validation-run-request" },
    "version": { "const": 1 },
    "requestKey": { "$ref": "common.v1.schema.json#/$defs/uuid" },
    "kind": { "type": "string", "enum": ["report", "validate", "basket"] },
    "strategyId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,79}$" },
    "sourceSha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256Hex",
      "description": "Optional guard: the client's view of the strategy source. The API rejects with 409 when the registered source differs, so a stale picker cannot submit against a changed strategy."
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "timeframe"],
      "properties": {
        "symbol": { "$ref": "common.v1.schema.json#/$defs/symbol" },
        "timeframe": { "$ref": "common.v1.schema.json#/$defs/timeframe" },
        "routeMode": { "type": "string", "enum": ["declared", "transfer"], "description": "Omit for normal declared-route execution. Transfer explicitly tests the same strategy source on an undeclared route; it must not change the strategy's approved routes." },
        "rangeMethod": { "type": "string", "enum": ["zone", "pivot"], "default": "zone" }
      }
    },
    "costMode": { "$ref": "common.v1.schema.json#/$defs/costMode" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "common.v1.schema.json#/$defs/isoDate" },
        "to": { "$ref": "common.v1.schema.json#/$defs/isoDate", "description": "Exclusive." },
        "holdoutFrom": { "$ref": "common.v1.schema.json#/$defs/isoDate" }
      }
    },
    "monteCarloIterations": { "type": "integer", "minimum": 100, "maximum": 20000 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295, "description": "Omit to let the API choose; set to reproduce a run deliberately." },
    "params": {
      "type": "object",
      "description": "Parameter overrides. Anything not listed takes the strategy's default.",
      "additionalProperties": { "type": ["number", "string", "boolean"] }
    }
  }
}
